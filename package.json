{
  "name": "cuaderno-gsi",
  "version": "3.0.0",
  "description": "App de estudio para la oposición GSI A2",
  "scripts": {
    "build": "node build.mjs",
    "build:web": "node build.mjs --web",
    "dev": "node build.mjs --watch",
    "preview": "node build.mjs --web && python3 -m http.server 8080 -d dist-web",
    "typecheck": "tsc --noEmit",
    "content": "python3 scripts/prepare_content.py"
  },
  "dependencies": {
    "@preact/signals": "^1.3.4",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3"
  },
  "private": true,
  "type": "module"
}